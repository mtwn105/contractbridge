# syntax=docker/dockerfile:1
FROM python:3.14.4-slim
COPY requirements.lock /opt/requirements.lock
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then PIP_CERT=/run/secrets/proxy_ca pip install --no-cache-dir -r /opt/requirements.lock; else pip install --no-cache-dir -r /opt/requirements.lock; fi
COPY src/contractbridge /app/contractbridge
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
CMD ["python", "-m", "uvicorn", "contractbridge.ingress:create_ingress", "--factory", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
